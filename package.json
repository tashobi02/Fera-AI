{
  "name": "fera-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/db/test-db.mjs",
    "model:fetch": "node scripts/model-fetch.mjs",
    "seed": "node db/seed/index.mjs",
    "synth": "node db/seed/synthetic.mjs",
    "reembed": "node scripts/reembed.mjs",
    "spend": "node scripts/spend.mjs",
    "smoke": "node scripts/smoke.mjs",
    "eval:all": "node eval/all.mjs",
    "eval:extract": "node eval/extract.mjs",
    "eval:match": "node eval/match.mjs",
    "eval:dedupe": "node eval/dedupe.mjs",
    "eval:wer": "node eval/wer.mjs",
    "eval:time": "node eval/time.mjs",
    "eval:audit": "node eval/audit.mjs",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "rehearsal:automated": "node scripts/rehearsal/run-automated-repeats.mjs",
    "demo:local": "node scripts/demo/cli.mjs",
    "release:check": "node scripts/release/check.mjs",
    "db:up": "bash scripts/db/up.sh",
    "db:reset": "node scripts/db/reset.mjs",
    "seed:users": "node scripts/db/seed-users.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@node-rs/argon2": "2.2.1",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
