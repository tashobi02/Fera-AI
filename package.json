{
  "name": "fera-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/db/test-db.mjs",
    "model:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/model-fetch.mjs",
    "seed": "node db/seed/index.mjs",
    "synth": "node db/seed/synthetic.mjs",
    "reembed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/reembed.mjs",
    "dedupe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dedupe.mjs",
    "spend": "node scripts/spend.mjs",
    "smoke": "node -e \"console.error('smoke: not implemented'); process.exit(1)\"",
    "eval:all": "node -e \"console.error('eval:all: not implemented'); process.exit(1)\"",
    "eval:extract": "node -e \"console.error('eval:extract: not implemented'); process.exit(1)\"",
    "eval:match": "node -e \"console.error('eval:match: not implemented'); process.exit(1)\"",
    "eval:dedupe": "node -e \"console.error('eval:dedupe: not implemented'); process.exit(1)\"",
    "eval:wer": "node -e \"console.error('eval:wer: not implemented'); process.exit(1)\"",
    "eval:time": "node -e \"console.error('eval:time: not implemented'); process.exit(1)\"",
    "eval:audit": "node -e \"console.error('eval:audit: not implemented'); process.exit(1)\"",
    "test:e2e": "node -e \"console.error('test:e2e: not implemented'); process.exit(1)\"",
    "db:up": "bash scripts/db/up.sh",
    "db:reset": "node scripts/db/reset.mjs",
    "seed:users": "node scripts/db/seed-users.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@node-rs/argon2": "2.2.1",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
